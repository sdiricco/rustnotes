{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RustNotes E2E",
  "identifier": "io.github.sdiricco.rustnotes.e2e",
  "build": {
    "beforeBuildCommand": "pnpm build:e2e:frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "capabilities": [
        {
          "identifier": "e2e",
          "windows": ["main"],
          "permissions": ["core:default", "core:window:default", "wdio:default"]
        }
      ]
    }
  }
}
